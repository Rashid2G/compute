# Compute installer configuration.
#
# Copy this file to .env, then set COMPUTE_ADMIN_PASSWORD (and COMPUTE_DOMAIN if
# you want DNS/HTTP names). Keep .env private: chmod 600 .env
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d
#
# Values here are safe defaults. Full reference: docs/configuration.md

# Container image tag. Pin this for reproducible upgrades and rollbacks.
COMPUTE_VERSION=2.0.0
COMPUTE_DAEMON_IMAGE=ghcr.io/rashid2g/compute-daemon
COMPUTE_WORKER_IMAGE=ghcr.io/rashid2g/compute-worker

# Host directory for the database, base images, VM disks and SSH key.
COMPUTE_HOST_DATA_DIR=./data

# API/embedded-GUI listener. 127.0.0.1 keeps a fresh install local-only.
# Set 0.0.0.0 (or a specific host address) to expose the API to your network.
COMPUTE_BIND_ADDRESS=127.0.0.1
COMPUTE_API_PORT=18080
# Address the container healthcheck calls. Set this to COMPUTE_BIND_ADDRESS when
# you bind a specific non-loopback address.
COMPUTE_HEALTHCHECK_HOST=127.0.0.1

# Authentication is required. The daemon refuses to start without a password
# or bootstrap admin secret. Generate one with: openssl rand -base64 32
COMPUTE_AUTH_ENABLED=true
COMPUTE_ADMIN_PASSWORD=
# COMPUTE_ADMIN_SECRET=

# Optional TLS on the API listener. Leave empty to terminate TLS in a reverse
# proxy or Tailscale. Both files must be readable inside the container.
COMPUTE_TLS_CERT_FILE=
COMPUTE_TLS_KEY_FILE=

# Optional DNS/HTTP edge. Empty COMPUTE_DOMAIN disables sandbox hostnames.
# Enabling DNS also starts the HTTP edge on :80 unless COMPUTE_EDGE_LISTEN is
# set (use "-" to disable just the edge). Ports 53/80 must be free.
COMPUTE_DOMAIN=
COMPUTE_DNS_ENABLED=false
COMPUTE_EDGE_LISTEN=

# Base images: download|prebuilt|build|none.
#   download  fetch the checksummed manifest at COMPUTE_IMAGE_MANIFEST_URL
#   prebuilt  validate images already present under COMPUTE_HOST_DATA_DIR/images
#   build     same validation, intended for images built by scripts/build-*.sh
#   none      skip image bootstrap (daemon readiness will report the gap)
# Artifacts are not published yet; use build/prebuilt with locally built images
# until a release manifest URL is available.
COMPUTE_IMAGES_MODE=build
COMPUTE_IMAGE_MANIFEST_URL=
COMPUTE_DEFAULT_KERNEL=vmlinux
COMPUTE_DEFAULT_ROOTFS=ubuntu-24.04.ext4

# Optional worker profile (experimental; multi-host only).
# Create a token first: compute worker token --name docker-worker
COMPUTE_WORKER_TOKEN=
COMPUTE_WORKER_NAME=docker-worker
COMPUTE_POOL_ID=default

# Optional separate GUI container (gui profile).
COMPUTE_GUI_BIND_ADDRESS=127.0.0.1
COMPUTE_GUI_PORT=8080

# Tailscale is opt-in. API key (or the tailscale profile auth key) is never
# committed. See docs/configuration.md and docs/tailscale.md.
COMPUTE_TAILSCALE_ENABLED=false
COMPUTE_TAILSCALE_API_KEY=
COMPUTE_TAILSCALE_TAILNET=-
COMPUTE_TAILSCALE_SERVICE_GATEWAY_ENABLED=false
COMPUTE_TAILSCALE_AUTHKEY=
COMPUTE_TAILSCALE_HOSTNAME=compute
COMPUTE_TAILSCALE_IMAGE=stable

# Optional network overrides (defaults work on most hosts).
COMPUTE_NETWORK_MODE=nat
COMPUTE_BRIDGE_NAME=mft3br0
COMPUTE_BRIDGE_IP=172.16.0.1/16
COMPUTE_SUBNET=172.16.0.0/16
COMPUTE_GATEWAY_IP=172.16.0.1
# On a shared host the daemon links only the bridges you name here. Linking
# every host bridge (the legacy behavior) creates L2 loops with Docker,
# libvirt, or another Compute deployment; enable it only on a dedicated host.
# COMPUTE_LINKED_BRIDGES=br0,br1
# COMPUTE_LINK_OTHER_BRIDGES=0

# Optional capacity limits (0 = unlimited).
COMPUTE_MAX_RUNNING_VMS=0
COMPUTE_MAX_TOTAL_VCPUS=0
COMPUTE_MAX_TOTAL_MEMORY_MB=0
COMPUTE_MAX_TOTAL_DISK_MB=0
COMPUTE_MIN_FREE_DISK_MB=512
