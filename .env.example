# Compute optional configuration overrides.
#
# Copy this file to .env only if you want to customize settings. Out of the
# box, `docker compose up -d` starts immediately without needing `.env`:
#   - binds to 127.0.0.1:18080 with default admin/admin credentials
#   - installs the Firecracker binary inside the container
#   - automatically installs the kernel, Ubuntu 24.04 rootfs, and SSH key
#
# Replace the default administrator password and secret before binding to a
# non-loopback address. Keep .env private: chmod 600 .env
#
# Values here are safe defaults. Full reference: docs/configuration.md

# Container image tag and pull policy (build|missing|always).
COMPUTE_VERSION=1.0.0
COMPUTE_PULL_POLICY=build
COMPUTE_DAEMON_IMAGE=ghcr.io/rashid2g/compute-daemon
COMPUTE_WORKER_IMAGE=ghcr.io/rashid2g/compute-worker

# Host directory for the database, base images, VM disks and SSH key.
COMPUTE_HOST_DATA_DIR=./data

# API/embedded-GUI listener. The default keeps the API local-only. Set
# 0.0.0.0 (or a specific host address) to expose it to your network/Tailscale
# after you have replaced the default administrator credentials below.
COMPUTE_BIND_ADDRESS=127.0.0.1
COMPUTE_API_PORT=18080
# Address the container healthcheck calls. Set this to COMPUTE_BIND_ADDRESS when
# you bind a specific non-loopback address.
COMPUTE_HEALTHCHECK_HOST=127.0.0.1

# Authentication is required. The local-only defaults let the stack start
# immediately, but change the password and secret before binding to a
# non-loopback address. Public self-registration is disabled by default; set
# COMPUTE_SIGNUP_ENABLED=true to allow users to create their own accounts.
# Generate strong values with: openssl rand -base64 32
COMPUTE_AUTH_ENABLED=true
COMPUTE_SIGNUP_ENABLED=false
COMPUTE_ADMIN_USERNAME=admin
COMPUTE_ADMIN_EMAIL=admin@compute.local
COMPUTE_ADMIN_PASSWORD=admin
# Optional static bearer secret for admin automation. Leave empty unless you
# need it; if set, use a long random value (openssl rand -base64 32).
# To use COMPUTE_ADMIN_SECRET without seeding an admin password, clear
# COMPUTE_ADMIN_PASSWORD= above (leave it empty).
COMPUTE_ADMIN_SECRET=

# Optional TLS on the API listener. Leave empty to terminate TLS in a reverse
# proxy or Tailscale. Both files must be readable inside the container.
COMPUTE_TLS_CERT_FILE=
COMPUTE_TLS_KEY_FILE=

# Externally reachable base URL of this daemon, for example
# https://compute-lab.tailb1be99.ts.net. Port-mode serve URLs use this host and
# the daemon advertises it on /api/v1/version. A value without a scheme is
# treated as https.
COMPUTE_PUBLIC_URL=

# Serving published sandbox ports. Every exposure gets its own origin:
#   subdomain mode  https://<slug>.<COMPUTE_SERVE_DOMAIN>/
#   port mode       https://<daemon-host>:<serve-port>/
# Leave COMPUTE_SERVE_DOMAIN empty to use localhost subdomains on loopback
# binds and port mode otherwise. Public subdomains need a wildcard DNS record
# (*.serves.example.com) and a wildcard certificate.
COMPUTE_SERVE_DOMAIN=
COMPUTE_SERVE_BIND=127.0.0.1
COMPUTE_SERVE_PORT_START=18400
COMPUTE_SERVE_PORT_END=18500
COMPUTE_SERVE_TLS_CERT_FILE=
COMPUTE_SERVE_TLS_KEY_FILE=
# HMAC key for private-serve tokens. Empty derives it from COMPUTE_ADMIN_SECRET,
# else uses a random per-process key (private serve sessions reset on restart).
COMPUTE_SERVE_TOKEN_KEY=

# Optional DNS/HTTP edge. Empty COMPUTE_DOMAIN disables sandbox hostnames.
# Enabling DNS also starts the HTTP edge on :80 unless COMPUTE_EDGE_LISTEN is
# set (use "-" to disable just the edge). Ports 53/80 must be free.
COMPUTE_DOMAIN=
COMPUTE_DNS_ENABLED=false
COMPUTE_EDGE_LISTEN=

# Base images: auto|download|prebuilt|build|none.
#   auto      automatically installs the pinned kernel, builds the Ubuntu 24.04
#             rootfs inside compute-init, and generates the internal SSH key
#             (or uses COMPUTE_IMAGE_MANIFEST_URL when set)
#   download  fetch the checksummed manifest at COMPUTE_IMAGE_MANIFEST_URL
#   prebuilt  validate images already present under COMPUTE_HOST_DATA_DIR/images
#   build     same as prebuilt, intended for images built with scripts/build-*.sh
#   none      skip image bootstrap (daemon readiness will report the gap)
COMPUTE_IMAGES_MODE=auto
COMPUTE_IMAGE_MANIFEST_URL=
COMPUTE_ROOTFS_SIZE_MB=2048
COMPUTE_DEFAULT_KERNEL=vmlinux
COMPUTE_DEFAULT_ROOTFS=ubuntu-24.04.ext4

# Optional worker profile (experimental; multi-host only).
# Create a token first with: compute worker token create --name docker-worker
# and paste the printed token here. An empty token makes the worker refuse to
# start, which is intentional.
COMPUTE_WORKER_TOKEN=
COMPUTE_WORKER_NAME=docker-worker
COMPUTE_POOL_ID=default

# Optional separate GUI container (gui profile). The daemon already serves the
# embedded UI on COMPUTE_API_PORT, so this is disabled by default. Uncomment
# COMPOSE_PROFILES to run the dedicated :8080 listener as well.
# COMPOSE_PROFILES=gui
COMPUTE_GUI_BIND_ADDRESS=127.0.0.1
COMPUTE_GUI_PORT=8080

# Optional network overrides (defaults work on most hosts).
COMPUTE_NETWORK_MODE=nat
COMPUTE_BRIDGE_NAME=mft3br0
COMPUTE_BRIDGE_IP=172.16.0.1/16
COMPUTE_SUBNET=172.16.0.0/16
COMPUTE_GATEWAY_IP=172.16.0.1
# On a shared host the daemon links only the bridges you name here. Linking
# every host bridge (the legacy behavior) creates L2 loops with Docker,
# libvirt, or another Compute deployment; enable it only on a dedicated host.
# COMPUTE_LINKED_BRIDGES=br0,br1
# COMPUTE_LINK_OTHER_BRIDGES=0

# Optional capacity limits (0 = unlimited).
COMPUTE_MAX_RUNNING_VMS=0
COMPUTE_MAX_TOTAL_VCPUS=0
COMPUTE_MAX_TOTAL_MEMORY_MB=0
COMPUTE_MAX_TOTAL_DISK_MB=0
COMPUTE_MIN_FREE_DISK_MB=512
