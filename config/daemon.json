{
  "server": {
    "listen": "0.0.0.0:18080",
    "db_path": "/var/lib/compute/data/compute.db",
    "firecracker_bin": "/usr/local/bin/firecracker"
  },
  "network": {
    "mode": "nat",
    "bridge_name": "mft3br0",
    "bridge_ip": "172.16.0.1/16",
    "subnet": "172.16.0.0/16",
    "gateway_ip": "172.16.0.1"
  },
  "defaults": {
    "vcpus": 1,
    "memory_mb": 2048,
    "disk_size_mb": 51200,
    "image": "ubuntu-24"
  },
  "images": {
    "images_dir": "/var/lib/compute/images",
    "vms_dir": "/var/lib/compute/vms",
    "default_kernel": "vmlinux",
    "default_rootfs": "ubuntu-24.04.ext4",
    "ssh_key_path": "/var/lib/compute/images/ssh/id_ed25519",
    "available": [
      {
        "name": "ubuntu-24",
        "kernel": "vmlinux",
        "rootfs": "ubuntu-24.04.ext4",
        "description": "Ubuntu 24.04 LTS (Noble Numbat) with Node.js 20, Python 3, git, jq, SSH, and sudo"
      },
      {
        "name": "app-server",
        "kernel": "vmlinux",
        "rootfs": "app-server.ext4",
        "description": "Compute application microVM (daemon :18080, Web GUI :8080, CLI, SSH)"
      }
    ]
  },
  "resources": {
    "max_running_vms": 0,
    "max_total_vcpus": 0,
    "max_total_memory_mb": 0,
    "max_total_disk_mb": 0,
    "min_free_disk_space_mb": 512
  },
  "jobs": {
    "local_execution": true,
    "max_concurrent": 2,
    "boot_timeout_seconds": 90
  },
  "dns": {
    "enabled": true,
    "listen": ":53",
    "base_domain": "compute-lab.tailb1be99.ts.net",
    "extra_base_domains": [],
    "host_addresses": ["100.78.129.96", "192.168.1.70"]
  },
  "tailscale": {
    "enabled": true,
    "api_key": "",
    "tailnet": "-",
    "node_tag": "tag:compute-master",
    "sandbox_tag": "tag:compute-sandbox",
    "hostname_prefix": "compute",
    "auto_install_guest": true,
    "default_sandboxes": false,
    "service_gateway": {
      "enabled": true,
      "host_tag": "tag:compute-master",
      "service_tag": "tag:compute-sandbox",
      "auto_approve": true,
      "scan_interval_seconds": 30,
      "expose_loopback": false
    }
  }
}
