{
  "server": {
    "listen": "0.0.0.0:18080",
    "db_path": "/home/rashid/on-demand-vms/data/compute.db",
    "firecracker_bin": "/usr/local/bin/firecracker"
  },
  "network": {
    "mode": "nat",
    "bridge_name": "mft3br0",
    "bridge_ip": "172.16.0.1/16",
    "subnet": "172.16.0.0/16",
    "gateway_ip": "172.16.0.1"
  },
  "defaults": {
    "vcpus": 1,
    "memory_mb": 2048,
    "disk_size_mb": 51200,
    "image": "ubuntu-24"
  },
  "images": {
    "images_dir": "/home/rashid/on-demand-vms/data/images",
    "vms_dir": "/home/rashid/on-demand-vms/data/vms",
    "default_kernel": "vmlinux",
    "default_rootfs": "ubuntu-24.04.ext4",
    "ssh_key_path": "/home/rashid/on-demand-vms/data/images/ssh/id_ed25519",
    "available": [
      {
        "name": "ubuntu-24",
        "kernel": "vmlinux",
        "rootfs": "ubuntu-24.04.ext4",
        "description": "Ubuntu 24.04 LTS (Noble Numbat) with Node.js 20, Python 3, git, jq, SSH, and sudo"
      }
    ]
  },
  "resources": {
    "max_running_vms": 4,
    "max_total_vcpus": 4,
    "max_total_memory_mb": 4096,
    "max_total_disk_mb": 204800,
    "min_free_disk_space_mb": 1024
