[Unit]
Description=Compute Worker Node Agent
After=computed.service
Wants=computed.service

[Service]
Type=simple
WorkingDirectory=/var/lib/compute-worker
ExecStart=/usr/local/bin/compute-worker run --control-plane http://127.0.0.1:18080 --name worker-primary --pool default
Restart=always
RestartSec=3s

[Install]
WantedBy=default.target
