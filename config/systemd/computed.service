[Unit]
Description=Compute Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/compute
# Default Tailscale settings before EnvironmentFile so /etc/compute/compute.env can override them:
Environment=COMPUTE_TAILSCALE_ENABLED=false
Environment=COMPUTE_TAILSCALE_TAILNET=-
# Tailscale admin API credentials and overrides live in an untracked, mode-600 file:
#   COMPUTE_TAILSCALE_API_KEY=<key>
# The leading '-' makes the file optional for hosts without the integration.
EnvironmentFile=-/etc/compute/compute.env
ExecStart=/usr/local/bin/computed --config /etc/compute/daemon.json -listen 0.0.0.0:18080
# Keep Firecracker microVM processes alive across daemon restarts/upgrades.
# Reconciliation re-adopts them by PID when the daemon comes back.
KillMode=process
Restart=always
RestartSec=3s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
