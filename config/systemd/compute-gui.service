[Unit]
Description=Compute Web GUI Server
After=computed.service
Wants=computed.service

[Service]
Type=simple
User=compute
WorkingDirectory=/var/lib/compute
ExecStart=/usr/local/bin/compute gui --addr 0.0.0.0 --port 8080 --daemon http://127.0.0.1:18080
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
