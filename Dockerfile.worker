# Multi-stage Dockerfile for Compute Worker Client
FROM golang:1.26-alpine AS builder

WORKDIR /src
ENV GOTOOLCHAIN=auto

RUN apk add --no-cache git make gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build worker client
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/compute-worker ./cmd/compute-worker

# Final runtime image
FROM alpine:3.21

# e2fsprogs-extra provides debugfs, mount/losetup provide loop mount fallback,
# and arptables provides ARP anti-spoofing filter rules for worker host networking.
RUN apk add --no-cache ca-certificates curl iproute2 iptables ebtables arptables tar gzip bash socat openssh-client e2fsprogs-extra mount losetup

# Install Firecracker & Jailer static binaries with pinned SHA-256 verification
ARG FIRECRACKER_VERSION=v1.17.0
ARG FIRECRACKER_SHA256_X86_64=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558
ARG FIRECRACKER_SHA256_AARCH64=e351ebe4f7a16b5873bbd51005d2e6767103cff4d5ebc829df2d3f95a93e2256
RUN set -eux; \
    ARCH="$(uname -m)"; \
    if [ "${ARCH}" = "x86_64" ]; then \
        FC_ARCH="x86_64"; \
        FC_SHA256="${FIRECRACKER_SHA256_X86_64}"; \
    elif [ "${ARCH}" = "aarch64" ]; then \
        FC_ARCH="aarch64"; \
        FC_SHA256="${FIRECRACKER_SHA256_AARCH64}"; \
    else \
        echo "Unsupported architecture: ${ARCH}" >&2; \
        exit 1; \
    fi; \
    TGZ="firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}.tgz"; \
    curl -fsSL -o "${TGZ}" "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER_VERSION}/${TGZ}"; \
    echo "${FC_SHA256}  ${TGZ}" | sha256sum -c -; \
    tar -xzf "${TGZ}"; \
    mv "release-${FIRECRACKER_VERSION}-${FC_ARCH}/firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}" /usr/local/bin/firecracker; \
    mv "release-${FIRECRACKER_VERSION}-${FC_ARCH}/jailer-${FIRECRACKER_VERSION}-${FC_ARCH}" /usr/local/bin/jailer; \
    chmod +x /usr/local/bin/firecracker /usr/local/bin/jailer; \
    rm -rf "release-${FIRECRACKER_VERSION}-${FC_ARCH}" "${TGZ}"

WORKDIR /var/lib/compute-worker

COPY --from=builder /bin/compute-worker /usr/local/bin/compute-worker

VOLUME ["/var/lib/compute-worker"]

ENTRYPOINT ["/usr/local/bin/compute-worker"]
CMD ["run"]
