# Multi-stage Dockerfile for Compute Central Daemon & Web UI
FROM golang:alpine AS builder

WORKDIR /src
ENV GOTOOLCHAIN=auto

RUN apk add --no-cache git make gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build central daemon, CLI, and worker binaries
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/computed ./cmd/computed
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/compute ./cmd/compute
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/compute-worker ./cmd/compute-worker

# Final minimal runtime image with Firecracker & network tooling
FROM alpine:3.20

# e2fsprogs-extra provides debugfs, and mount/losetup provide the loop mount
# fallback; both are used to configure SSH keys, passwords, and sshd policy
# inside guest disk images.
RUN apk add --no-cache ca-certificates curl iproute2 iptables ebtables openssh-client bash socat tar gzip e2fsprogs-extra mount losetup

# Install Firecracker & Jailer static binaries
ARG FIRECRACKER_VERSION=v1.17.0
RUN set -eux; \
    ARCH="$(uname -m)"; \
    if [ "${ARCH}" = "x86_64" ]; then \
        FC_ARCH="x86_64"; \
    elif [ "${ARCH}" = "aarch64" ]; then \
        FC_ARCH="aarch64"; \
    else \
        FC_ARCH="x86_64"; \
    fi; \
    curl -fsSL "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER_VERSION}/firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}.tgz" | tar -xz; \
    mv "release-${FIRECRACKER_VERSION}-${FC_ARCH}/firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}" /usr/local/bin/firecracker; \
    mv "release-${FIRECRACKER_VERSION}-${FC_ARCH}/jailer-${FIRECRACKER_VERSION}-${FC_ARCH}" /usr/local/bin/jailer; \
    chmod +x /usr/local/bin/firecracker /usr/local/bin/jailer; \
    rm -rf "release-${FIRECRACKER_VERSION}-${FC_ARCH}"

# Install the Tailscale CLI. The daemon uses it to configure Service endpoints
# on the host's tailscaled (the control socket is mounted by docker-compose).
# Only the client binary is needed; tailscaled itself runs on the host.
ARG TAILSCALE_VERSION=1.104.6
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "${ARCH}" in \
        x86_64) TS_ARCH="amd64" ;; \
        aarch64) TS_ARCH="arm64" ;; \
        *) echo "unsupported arch ${ARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://pkgs.tailscale.com/stable/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}.tgz" -o /tmp/tailscale.tgz; \
    tar -xzf /tmp/tailscale.tgz -C /tmp; \
    mv "/tmp/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}/tailscale" /usr/local/bin/tailscale; \
    chmod +x /usr/local/bin/tailscale; \
    rm -rf /tmp/tailscale.tgz "/tmp/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}"

WORKDIR /var/lib/compute

# Pre-create data and image directories
RUN mkdir -p /var/lib/compute/data /var/lib/compute/images/ssh /var/lib/compute/vms /etc/compute

COPY --from=builder /bin/computed /usr/local/bin/computed
COPY --from=builder /bin/compute /usr/local/bin/compute
COPY --from=builder /bin/compute-worker /usr/local/bin/compute-worker
COPY config/daemon.json /etc/compute/daemon.json

# Expose Central REST API (18080) and Web GUI (8080)
EXPOSE 18080 8080

VOLUME ["/var/lib/compute"]

ENTRYPOINT ["/usr/local/bin/computed"]
CMD ["--config", "/etc/compute/daemon.json"]
