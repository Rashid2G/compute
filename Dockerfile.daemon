# Multi-stage Dockerfile for Compute Central Daemon & Web UI
FROM golang:1.26-alpine AS builder

WORKDIR /src
ENV GOTOOLCHAIN=auto

RUN apk add --no-cache git make gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build central daemon, CLI, and worker binaries
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/computed ./cmd/computed
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/compute ./cmd/compute
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /bin/compute-worker ./cmd/compute-worker

# Final minimal runtime image with Firecracker & network tooling
FROM alpine:3.21

# e2fsprogs provides mkfs.ext4/e2fsck/resize2fs, e2fsprogs-extra provides
# debugfs, mount/losetup provide the loop mount fallback, xfsprogs provides
# mkfs.xfs for XFS volumes, and arptables provides ARP anti-spoofing rules;
# together they bootstrap rootfs, format disks, and secure VM networking.
RUN apk add --no-cache ca-certificates curl iproute2 iptables ebtables arptables xfsprogs openssh-client bash socat tar gzip e2fsprogs e2fsprogs-extra mount losetup

# Install Firecracker & Jailer static binaries with SHA-256 verification
ARG FIRECRACKER_VERSION=v1.17.0
RUN set -eux; \
    ARCH="$(uname -m)"; \
    if [ "${ARCH}" = "x86_64" ]; then \
        FC_ARCH="x86_64"; \
    elif [ "${ARCH}" = "aarch64" ]; then \
        FC_ARCH="aarch64"; \
    else \
        FC_ARCH="x86_64"; \
    fi; \
    curl -fsSL -O "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER_VERSION}/firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}.tgz"; \
    curl -fsSL -O "https://github.com/firecracker-microvm/firecracker/releases/download/${FIRECRACKER_VERSION}/firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}.tgz.sha256.txt"; \
    sha256sum -c "firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}.tgz.sha256.txt"; \
    tar -xzf "firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}.tgz"; \
    mv "release-${FIRECRACKER_VERSION}-${FC_ARCH}/firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}" /usr/local/bin/firecracker; \
    mv "release-${FIRECRACKER_VERSION}-${FC_ARCH}/jailer-${FIRECRACKER_VERSION}-${FC_ARCH}" /usr/local/bin/jailer; \
    chmod +x /usr/local/bin/firecracker /usr/local/bin/jailer; \
    rm -rf "release-${FIRECRACKER_VERSION}-${FC_ARCH}" "firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}.tgz" "firecracker-${FIRECRACKER_VERSION}-${FC_ARCH}.tgz.sha256.txt"

WORKDIR /var/lib/compute

# Pre-create data and image directories
RUN mkdir -p /var/lib/compute/data /var/lib/compute/images/ssh /var/lib/compute/vms /etc/compute /usr/local/share/compute

COPY --from=builder /bin/computed /usr/local/bin/computed
COPY --from=builder /bin/compute /usr/local/bin/compute
COPY --from=builder /bin/compute-worker /usr/local/bin/compute-worker
COPY config/daemon.json /etc/compute/daemon.json
COPY scripts/build-rootfs-chroot.sh /usr/local/share/compute/build-rootfs-chroot.sh
RUN chmod +x /usr/local/share/compute/build-rootfs-chroot.sh

# Expose Central REST API (18080) and Web GUI (8080)
EXPOSE 18080 8080

VOLUME ["/var/lib/compute"]

ENTRYPOINT ["/usr/local/bin/computed"]
CMD ["--config", "/etc/compute/daemon.json"]
